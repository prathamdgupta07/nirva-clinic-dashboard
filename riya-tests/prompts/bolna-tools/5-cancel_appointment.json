{
  "name": "cancel_appointment",
  "description": "Cancel a confirmed appointment, only after identity is confirmed and the caller clearly said yes to cancelling.",
  "pre_call_message": "Let me cancel that.",
  "parameters": {
    "type": "object",
    "properties": {
      "doctor_name": {
        "type": "string",
        "description": "Doctor's full name exactly as listed, e.g. 'Dr. Ananya Sharma'"
      },
      "patient_name": {
        "type": "string",
        "description": "Recorded patient name from the lookup"
      },
      "phone_number": {
        "type": "string",
        "description": "Caller-confirmed phone number in + country code format, e.g. +919876543210"
      },
      "existing_appointment_datetime": {
        "type": "string",
        "description": "Slot to cancel, YYYY-MM-DD HH:mm"
      },
      "platform_call_id": {
        "type": "string",
        "description": "This call's ID from the prompt (execution_id)"
      }
    },
    "required": [
      "doctor_name",
      "patient_name",
      "phone_number",
      "existing_appointment_datetime"
    ]
  },
  "key": "custom_task",
  "value": {
    "method": "POST",
    "url": "https://esvurkdwzcxtzimbpkwv.supabase.co/functions/v1/cancel-appointment",
    "param": {
      "doctor_name": "%(doctor_name)s",
      "patient_name": "%(patient_name)s",
      "phone_number": "%(phone_number)s",
      "existing_appointment_datetime": "%(existing_appointment_datetime)s",
      "platform_call_id": "%(platform_call_id)s"
    },
    "api_token": null,
    "headers": {
      "Content-Type": "application/json",
      "x-webhook-secret": "PASTE_BOLNA_SECRET_HERE"
    }
  }
}