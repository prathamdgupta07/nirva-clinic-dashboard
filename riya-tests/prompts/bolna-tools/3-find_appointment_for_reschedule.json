{
  "name": "find_appointment_for_reschedule",
  "description": "Look up the caller's existing confirmed appointment before rescheduling or cancelling. Returns the recorded patient name.",
  "pre_call_message": "Let me find your appointment.",
  "parameters": {
    "type": "object",
    "properties": {
      "doctor_name": {
        "type": "string",
        "description": "Doctor's full name exactly as listed, e.g. 'Dr. Ananya Sharma'"
      },
      "phone_number": {
        "type": "string",
        "description": "Caller-confirmed phone number in + country code format, e.g. +919876543210"
      },
      "existing_appointment_datetime": {
        "type": "string",
        "description": "Current appointment, YYYY-MM-DD HH:mm, 24-hour"
      }
    },
    "required": [
      "doctor_name",
      "phone_number",
      "existing_appointment_datetime"
    ]
  },
  "key": "custom_task",
  "value": {
    "method": "POST",
    "url": "https://esvurkdwzcxtzimbpkwv.supabase.co/functions/v1/find-appointment-for-reschedule",
    "param": {
      "doctor_name": "%(doctor_name)s",
      "phone_number": "%(phone_number)s",
      "existing_appointment_datetime": "%(existing_appointment_datetime)s"
    },
    "api_token": null,
    "headers": {
      "Content-Type": "application/json",
      "x-webhook-secret": "PASTE_BOLNA_SECRET_HERE"
    }
  }
}